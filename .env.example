# Copy to .env and fill in. Never commit .env.

# Where data lives: "memory" (data/seed.json, resets on restart) or "airtable"
STORE=memory
SEED_PATH=data/seed.json

# Airtable (only for STORE=airtable and the setup/seed scripts)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Evals
ANTHROPIC_API_KEY=
EVAL_MODEL=claude-sonnet-5-5

# Business rules
DISCOUNT_CAP_PCT=10
REMINDER_SPACING_DAYS=7
PREVIEW_EXPIRY_MINUTES=10
COMPANY_NAME=Summit Heating & Air
ACTOR=owner

# Optional: pretend today is this date (YYYY-MM-DD). Leave empty for the real date.
TODAY=
